#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CONFIG_PATH="${GORELEASER_CONFIG:-.goreleaser-ghx.yml}"
STRICT_PRODUCTION=0

usage() {
	cat <<'USAGE'
Usage: packaging/ghx/scripts/check-release-readiness [--strict-production]

Checks the secret-free ghx release readiness contract:

- the fork GoReleaser config keeps ghx identity and stays non-publishing
- package metadata uses ghx names and side-by-side defaults
- production-only blockers are reported without needing signing credentials

Use --strict-production when a release operator wants the command to fail until
all known production blockers are cleared.
USAGE
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--strict-production)
			STRICT_PRODUCTION=1
			shift
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			printf 'unknown argument: %s\n' "$1" >&2
			usage >&2
			exit 2
			;;
	esac
done

cd "$ROOT_DIR"

failures=()
warnings=()
blockers=()

add_failure() {
	failures+=("$1")
}

add_warning() {
	warnings+=("$1")
}

add_blocker() {
	blockers+=("$1")
}

require_file() {
	local path="$1"
	if [ ! -f "$path" ]; then
		add_failure "missing required file: $path"
	fi
}

require_file "$CONFIG_PATH"
require_file ".github/workflows/ghx-release-snapshot.yml"
require_file "docs/plans/ghx-release-smoke-matrix.md"
require_file "docs/plans/ghx-platform-package-channels.md"

if command -v goreleaser >/dev/null 2>&1; then
	goreleaser check -f "$CONFIG_PATH"
else
	add_warning "goreleaser is not on PATH, skipped goreleaser check -f $CONFIG_PATH"
fi

if command -v ruby >/dev/null 2>&1 && [ -f "$CONFIG_PATH" ]; then
	ruby -ryaml - "$CONFIG_PATH" <<'RUBY'
path = ARGV.fetch(0)
config = YAML.load_file(path)
errors = []

def expect(errors, condition, message)
  errors << message unless condition
end

expect(errors, config["project_name"] == "ghx", "project_name must be ghx")

release = config.fetch("release", {})
expect(errors, release["disable"] == true, "release.disable must stay true for secret-free readiness")
github = release.fetch("github", {})
expect(errors, github["owner"] == "agustif", "release.github.owner must be agustif")
expect(errors, github["name"] == "ghx", "release.github.name must be ghx")

forbidden = %w[
  aurs blobs blob_signs brews chocolateys dockers docker_manifests
  homebrew_casks kos nix publishers signs snapcrafts scoop sboms winget
]
present = forbidden.select { |key| config.key?(key) }
expect(errors, present.empty?, "publishing/signing sections are not allowed in #{path}: #{present.join(", ")}")

builds = Array(config["builds"])
expect(errors, !builds.empty?, "builds must not be empty")
builds.each do |build|
  id = build.fetch("id", "<missing>")
  expect(errors, build["binary"] == "bin/ghx", "build #{id} must output bin/ghx")
  ldflags = Array(build["ldflags"]).join(" ")
  expect(errors, ldflags.include?("internal/build.Name=ghx"), "build #{id} must set internal/build.Name=ghx")
end

archives = Array(config["archives"])
expect(errors, !archives.empty?, "archives must not be empty")
archives.each do |archive|
  id = archive.fetch("id", "<missing>")
  name_template = archive["name_template"].to_s
  expect(errors, name_template.start_with?("ghx_"), "archive #{id} name_template must start with ghx_")
end

nfpms = Array(config["nfpms"])
expect(errors, !nfpms.empty?, "nfpms must define local deb/rpm metadata")
nfpms.each do |nfpm|
  id = nfpm.fetch("id", "<missing>")
  expect(errors, nfpm["package_name"] == "ghx", "nfpm #{id} package_name must be ghx")
  expect(errors, nfpm["homepage"] == "https://github.com/agustif/ghx", "nfpm #{id} homepage must be agustif/ghx")
  expect(errors, nfpm["vendor"] == "agustif", "nfpm #{id} vendor must be agustif")
  forbidden_keys = %w[conflicts replaces provides]
  used = forbidden_keys.select { |key| nfpm.key?(key) && Array(nfpm[key]).any? }
  expect(errors, used.empty?, "nfpm #{id} must not conflict, replace, or provide upstream gh by default")

  contents = Array(nfpm["contents"])
  rendered = contents.map { |item| item.to_s }.join("\n")
  expect(errors, rendered.include?("ghx"), "nfpm #{id} contents must include ghx-owned paths")
end

if errors.any?
  warn errors.map { |error| "readiness config error: #{error}" }.join("\n")
  exit 1
end
RUBY
else
	add_warning "ruby is not on PATH, skipped YAML identity checks for $CONFIG_PATH"
fi

if [ -f "script/pkgmacos" ] && grep -Eq 'bin_path="/bin/gh"|com.github.cli|gh_\$\{tag_name\}_macOS_universal.pkg' "script/pkgmacos"; then
	add_blocker "#61 macOS pkg remains upstream gh-shaped in script/pkgmacos"
fi

if [ -f "build/windows/gh.wxs" ] && grep -Eq 'Name="GitHub CLI"|Name="gh.exe"|SOFTWARE\\GitHub\\CLI' "build/windows/gh.wxs"; then
	add_blocker "#62 Windows MSI WiX metadata remains upstream gh-shaped"
fi

if [ -f ".github/workflows/homebrew-bump.yml" ] && grep -Fq "formula-name: gh" ".github/workflows/homebrew-bump.yml"; then
	add_blocker "#63 Homebrew automation still targets formula gh"
fi

if [ -f ".github/workflows/deployment.yml" ] && grep -Eq 'dist/gh_\*_windows_\*\.zip|dist/\*\.pkg|script/release --local' ".github/workflows/deployment.yml"; then
	add_blocker "#57 production deployment workflow is still inherited from upstream gh"
fi

if [ -f "$CONFIG_PATH" ] && grep -Fq "disable: true" "$CONFIG_PATH"; then
	add_blocker "#65 production release publication, signing, and attestations are intentionally disabled in $CONFIG_PATH"
fi

if [ "${#failures[@]}" -gt 0 ]; then
	printf 'ghx release readiness secret-free checks failed\n' >&2
	printf '\nFailures:\n' >&2
	for failure in "${failures[@]}"; do
		printf -- '- %s\n' "$failure" >&2
	done
	exit 1
fi

printf 'ghx release readiness secret-free checks passed\n'

if [ "${#warnings[@]}" -gt 0 ]; then
	printf '\nWarnings:\n'
	for warning in "${warnings[@]}"; do
		printf -- '- %s\n' "$warning"
	done
fi

printf '\nProduction blockers:\n'
if [ "${#blockers[@]}" -eq 0 ]; then
	printf -- '- none recorded by this checker\n'
else
	for blocker in "${blockers[@]}"; do
		printf -- '- %s\n' "$blocker"
	done
fi

if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
	{
		echo "### ghx release readiness"
		echo
		echo "- Secret-free config checks: passed"
		echo "- Strict production mode: $STRICT_PRODUCTION"
		echo
		echo "Production blockers:"
		if [ "${#blockers[@]}" -eq 0 ]; then
			echo "- none recorded by this checker"
		else
			for blocker in "${blockers[@]}"; do
				echo "- $blocker"
			done
		fi
		if [ "${#warnings[@]}" -gt 0 ]; then
			echo
			echo "Warnings:"
			for warning in "${warnings[@]}"; do
				echo "- $warning"
			done
		fi
	} >>"$GITHUB_STEP_SUMMARY"
fi

if [ "$STRICT_PRODUCTION" -eq 1 ] && [ "${#blockers[@]}" -gt 0 ]; then
	printf '\nStrict production readiness failed because blockers remain.\n' >&2
	exit 1
fi
