#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
DIST_DIR="${GHX_RELEASE_DIST_DIR:-dist}"
REQUIRE_PACKAGE_TOOLS="${GHX_SMOKE_REQUIRE_PACKAGE_TOOLS:-0}"

usage() {
	cat <<'USAGE'
Usage: packaging/ghx/scripts/smoke-release-artifacts [--dist DIR]

Inspects ghx GoReleaser output without installing packages or using signing
credentials. The check is intentionally local and side-effect free.

Set GHX_SMOKE_REQUIRE_PACKAGE_TOOLS=1 to fail when dpkg-deb or rpm is missing.
USAGE
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--dist)
			DIST_DIR="${2:-}"
			if [ -z "$DIST_DIR" ]; then
				printf '--dist requires a directory\n' >&2
				exit 2
			fi
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			printf 'unknown argument: %s\n' "$1" >&2
			usage >&2
			exit 2
			;;
	esac
done

cd "$ROOT_DIR"

failures=()
warnings=()
checked=()

add_failure() {
	failures+=("$1")
}

add_warning() {
	warnings+=("$1")
}

add_checked() {
	checked+=("$1")
}

collect_files() {
	local pattern="$1"
	find "$DIST_DIR" -maxdepth 1 -type f -name "$pattern" -print | sort
}

require_tool_for_package() {
	local tool="$1"
	local package_kind="$2"
	if command -v "$tool" >/dev/null 2>&1; then
		return 0
	fi

	local message="$tool is not on PATH, skipped $package_kind package inspection"
	if [ "$REQUIRE_PACKAGE_TOOLS" = "1" ]; then
		add_failure "$message"
	else
		add_warning "$message"
	fi
	return 1
}

if [ ! -d "$DIST_DIR" ]; then
	printf 'dist directory not found: %s\n' "$DIST_DIR" >&2
	exit 1
fi

gh_artifacts=()
while IFS= read -r file; do
	gh_artifacts+=("$file")
done < <(collect_files 'gh_*')

if [ "${#gh_artifacts[@]}" -gt 0 ]; then
	for artifact in "${gh_artifacts[@]}"; do
		add_failure "unexpected upstream gh artifact: $artifact"
	done
fi

ghx_archives=()
while IFS= read -r file; do
	ghx_archives+=("$file")
done < <(collect_files 'ghx_*.tar.gz')
while IFS= read -r file; do
	ghx_archives+=("$file")
done < <(collect_files 'ghx_*.zip')

if [ "${#ghx_archives[@]}" -eq 0 ]; then
	add_failure "expected at least one ghx archive in $DIST_DIR"
fi

for archive in "${ghx_archives[@]}"; do
	base="$(basename "$archive")"
	case "$base" in
		ghx_*_linux_*.tar.gz)
			if ! tar -tzf "$archive" | grep -Eq '(^|/)bin/ghx$'; then
				add_failure "$base does not contain bin/ghx"
			fi
			if tar -tzf "$archive" | grep -Eq '(^|/)bin/gh$'; then
				add_failure "$base contains upstream bin/gh"
			fi
			add_checked "$base linux archive"
			;;
		ghx_*_macOS_*.zip)
			if ! unzip -Z1 "$archive" | grep -Eq '(^|/)bin/ghx$'; then
				add_failure "$base does not contain bin/ghx"
			fi
			if unzip -Z1 "$archive" | grep -Eq '(^|/)bin/gh$'; then
				add_failure "$base contains upstream bin/gh"
			fi
			add_checked "$base macOS archive"
			;;
		ghx_*_windows_*.zip)
			if ! unzip -Z1 "$archive" | grep -Eq '(^|/)bin/ghx\.exe$'; then
				add_failure "$base does not contain bin/ghx.exe"
			fi
			if unzip -Z1 "$archive" | grep -Eq '(^|/)bin/gh\.exe$'; then
				add_failure "$base contains upstream bin/gh.exe"
			fi
			add_checked "$base windows archive"
			;;
		*)
			add_warning "unclassified ghx archive: $base"
			;;
	esac
done

checksums=()
while IFS= read -r file; do
	checksums+=("$file")
done < <(collect_files 'ghx_*_checksums.txt')

if [ "${#checksums[@]}" -eq 0 ]; then
	add_failure "expected ghx_*_checksums.txt in $DIST_DIR"
fi

for checksum_file in "${checksums[@]}"; do
	base="$(basename "$checksum_file")"
	if ! grep -Fq 'ghx_' "$checksum_file"; then
		add_failure "$base does not list ghx artifacts"
	fi
	if grep -Eq '(^|[[:space:]])gh_' "$checksum_file"; then
		add_failure "$base lists upstream gh artifacts"
	fi
	add_checked "$base checksum file"
done

debs=()
while IFS= read -r file; do
	debs+=("$file")
done < <(collect_files 'ghx_*_linux_*.deb')

if [ "${#debs[@]}" -eq 0 ]; then
	add_failure "expected ghx deb package in $DIST_DIR"
elif require_tool_for_package dpkg-deb deb; then
	for deb in "${debs[@]}"; do
		base="$(basename "$deb")"
		package_name="$(dpkg-deb -f "$deb" Package)"
		if [ "$package_name" != "ghx" ]; then
			add_failure "$base package name is $package_name, expected ghx"
		fi
		deb_listing="$(dpkg-deb -c "$deb")"
		if ! grep -Eq ' \./usr/bin/ghx$' <<<"$deb_listing"; then
			add_failure "$base does not install ./usr/bin/ghx"
		fi
		if grep -Eq ' \./usr/bin/gh$' <<<"$deb_listing"; then
			add_failure "$base installs upstream ./usr/bin/gh"
		fi
		if ! grep -Eq 'ghx(\.1|\.fish)?$|/completions/ghx$|/_ghx$' <<<"$deb_listing"; then
			add_failure "$base does not include ghx manpage or completion paths"
		fi
		add_checked "$base deb package"
	done
fi

rpms=()
while IFS= read -r file; do
	rpms+=("$file")
done < <(collect_files 'ghx_*_linux_*.rpm')

if [ "${#rpms[@]}" -eq 0 ]; then
	add_failure "expected ghx rpm package in $DIST_DIR"
elif require_tool_for_package rpm rpm; then
	for rpm_file in "${rpms[@]}"; do
		base="$(basename "$rpm_file")"
		package_name="$(rpm -qp --queryformat '%{NAME}\n' "$rpm_file")"
		if [ "$package_name" != "ghx" ]; then
			add_failure "$base package name is $package_name, expected ghx"
		fi
		rpm_listing="$(rpm -qlp "$rpm_file")"
		if ! grep -Fxq '/usr/bin/ghx' <<<"$rpm_listing"; then
			add_failure "$base does not install /usr/bin/ghx"
		fi
		if grep -Fxq '/usr/bin/gh' <<<"$rpm_listing"; then
			add_failure "$base installs upstream /usr/bin/gh"
		fi
		if ! grep -Eq 'ghx(\.1|\.fish)?$|/completions/ghx$|/_ghx$' <<<"$rpm_listing"; then
			add_failure "$base does not include ghx manpage or completion paths"
		fi
		add_checked "$base rpm package"
	done
fi

printf 'ghx release artifact smoke summary\n'
printf 'dist: %s\n' "$DIST_DIR"
printf '\nChecked:\n'
if [ "${#checked[@]}" -eq 0 ]; then
	printf -- '- none\n'
else
	for item in "${checked[@]}"; do
		printf -- '- %s\n' "$item"
	done
fi

if [ "${#warnings[@]}" -gt 0 ]; then
	printf '\nWarnings:\n'
	for warning in "${warnings[@]}"; do
		printf -- '- %s\n' "$warning"
	done
fi

if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
	{
		echo "### ghx release artifact smoke"
		echo
		echo "Dist: \`$DIST_DIR\`"
		echo
		echo "Checked:"
		if [ "${#checked[@]}" -eq 0 ]; then
			echo "- none"
		else
			for item in "${checked[@]}"; do
				echo "- $item"
			done
		fi
		if [ "${#warnings[@]}" -gt 0 ]; then
			echo
			echo "Warnings:"
			for warning in "${warnings[@]}"; do
				echo "- $warning"
			done
		fi
	} >>"$GITHUB_STEP_SUMMARY"
fi

if [ "${#failures[@]}" -gt 0 ]; then
	printf '\nFailures:\n' >&2
	for failure in "${failures[@]}"; do
		printf -- '- %s\n' "$failure" >&2
	done
	exit 1
fi

printf '\nghx release artifact smoke passed\n'
