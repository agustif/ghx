# Non-secret macOS pkg identity inputs for ghx.
# Copy these values into the release issue or package PR before enabling a
# fork-owned pkg build. Do not put certificate material in this file.

GHX_PKG_PRODUCT_NAME="ghx"
GHX_PKG_IDENTIFIER="io.github.agustif.ghx"
GHX_PKG_COMPONENT_IDENTIFIER="io.github.agustif.ghx.cli"
GHX_PKG_OUTPUT_TEMPLATE="ghx_${VERSION}_macOS_universal.pkg"
GHX_PKG_INSTALL_LOCATION="/"
GHX_PKG_BINARY_PATH="/usr/local/bin/ghx"
GHX_PKG_ZSH_COMPLETION_PATH="/usr/local/share/zsh/site-functions/_ghx"
GHX_PKG_MANPAGE_GLOB="/usr/local/share/man/man1/ghx*.1"

# Required production records, not secrets.
GHX_PKG_DEVELOPER_ID_APPLICATION="TODO Developer ID Application identity"
GHX_PKG_DEVELOPER_ID_INSTALLER="TODO Developer ID Installer identity"
GHX_PKG_NOTARY_TEAM_ID="TODO Apple team id"
GHX_PKG_NOTARY_PROFILE="TODO notarytool profile name"
GHX_PKG_UNINSTALL_POLICY="TODO receipt forget or uninstall script policy"
